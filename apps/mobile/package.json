{
  "name": "@skillswap/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 19000",
    "android": "expo start --android --port 19000",
    "ios": "expo start --ios --port 19000",
    "web": "expo start --web --port 19000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "EXPO_PUBLIC_API_URL=http://127.0.0.1:4000 EXPO_PUBLIC_APP_ENV=local node --import tsx --test src/lib/env.test.ts src/services/api/errors.test.ts src/services/api/auth.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "^5.0.5",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@skillswap/shared": "workspace:*",
    "expo": "~53.0.20",
    "expo-constants": "~17.1.7",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.10",
    "query-string": "^9.5.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "babel-preset-expo": "~13.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~9.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3"
