# Learn more: https://docs.expo.dev/guides/environment-variables/

# Public API base URL (no secrets). Override per target:
# - iOS Simulator: http://127.0.0.1:4000
# - Android Emulator: http://10.0.2.2:4000
# - Physical device: http://<your-lan-ip>:4000
# - Preview/Prod: https://api.skillswap.example
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# local | preview | production
EXPO_PUBLIC_APP_ENV=local
